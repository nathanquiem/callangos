PORT=3333
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173,http://localhost:5174

# Sem DATABASE_URL, a API usa PostgreSQL embutido em .data/callangos.
# No Coolify, aponte para uma instância PostgreSQL normal.
DATABASE_URL=postgres://callangos:change-me@postgres:5432/callangos
PGLITE_DATA_DIR=.data/callangos
SEED_DEMO_DATA=false
WEBHOOK_SIGNING_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=troque-esta-senha
ALLOW_DEV_AUTH_BYPASS=false
